<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_freigabe" targetNamespace="https://bedarfsanfrage.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_freigabe">
    <bpmn:participant id="P_Frei" name="DIHAG SHB · Freigabelauf" processRef="Process_Bedarfsanfrage_Freigabelauf" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bedarfsanfrage_Freigabelauf" name="Freigabelauf (Power Automate)" isExecutable="false">
    <bpmn:documentation>Power-Automate-Flow „Bedarfsanfragen SHB&quot;. Er startet nur, wenn eine Anfrage auf Genehmigt (Einkauf) steht, andere Änderungen lösen ihn nicht aus. Fehlt der geschätzte Preis, gibt er die Anfrage zurück an den Einkauf (Status In Prüfung (Einkauf)) und schreibt dem, der genehmigt hat, eine Mail. Eine Freigabe startet dann nicht. Das Controlling prüft indirektes Material und die Warengruppen 2000, 4333 bis 4338 und 4340, die Werkleitung ab 1.500 € Bestellvolumen, der strategische Einkauf ab 10.000 € und nur ohne Lead-Buyer-Abschluss. Jede Stufe bekommt eine Genehmigung in Teams und per Mail, die erste Antwort zählt. Die Genehmigung enthält die Positionen und die Angebote als Anhang (Dateien über etwa 4 MB nur über den Link in die App). Vor Werkleitung und strategischem Einkauf holt der Flow die Angebote neu, damit auch nachgereichte dabei sind. Bei Ablehnung setzt der Flow den Status Abgelehnt, sonst Freigegeben, und schreibt dem Antragsteller in beiden Fällen eine Mail.
Eingebunden in: Bedarfsanfrage.
Anwender-Ansicht: https://bedarfsanfrage.dihag-extern.com/?ansicht=prozess&amp;modell=freigabe
Im Einklang mit den Richtlinien: Konzernfachregelung Prozessmanagement; ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=120,119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Frei">
      <bpmn:lane id="LA" name="Power Automate (Flow Bedarfsanfragen SHB)"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw0</bpmn:flowNodeRef><bpmn:flowNodeRef>A_zur</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endZur</bpmn:flowNodeRef><bpmn:flowNodeRef>A_hol</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ctrl</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ang1</bpmn:flowNodeRef><bpmn:flowNodeRef>A_wl</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw3</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ang2</bpmn:flowNodeRef><bpmn:flowNodeRef>A_se</bpmn:flowNodeRef><bpmn:flowNodeRef>A_frei</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endOk</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ab</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endAb</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Controlling"><bpmn:flowNodeRef>B_pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>B_gw</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LC" name="Werkleitung"><bpmn:flowNodeRef>C_pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>C_gw</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LD" name="Strategischer Einkauf"><bpmn:flowNodeRef>D_pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Status steht auf Genehmigt (Einkauf)"><bpmn:outgoing>Flow_A_start_A_gw0</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_gw0" name="Geschätzter Preis eingetragen?"><bpmn:incoming>Flow_A_start_A_gw0</bpmn:incoming><bpmn:outgoing>Flow_A_gw0_A_hol</bpmn:outgoing><bpmn:outgoing>Flow_A_gw0_A_zur</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_zur" name="An den Einkauf zurückgeben, Mail schicken"><bpmn:incoming>Flow_A_gw0_A_zur</bpmn:incoming><bpmn:outgoing>Flow_A_zur_A_endZur</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_endZur" name="Zurück an Einkauf, Preis fehlt"><bpmn:incoming>Flow_A_zur_A_endZur</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_hol" name="Angebote und Positionen holen"><bpmn:incoming>Flow_A_gw0_A_hol</bpmn:incoming><bpmn:outgoing>Flow_A_hol_A_gw1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_gw1" name="Prüft das Controlling?"><bpmn:incoming>Flow_A_hol_A_gw1</bpmn:incoming><bpmn:outgoing>Flow_A_gw1_A_ctrl</bpmn:outgoing><bpmn:outgoing>Flow_A_gw1_A_gw2</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_ctrl" name="Controlling um Freigabe bitten"><bpmn:incoming>Flow_A_gw1_A_ctrl</bpmn:incoming><bpmn:outgoing>Flow_A_ctrl_B_pruef</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="B_pruef" name="Anfrage prüfen"><bpmn:incoming>Flow_A_ctrl_B_pruef</bpmn:incoming><bpmn:outgoing>Flow_B_pruef_B_gw</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="B_gw" name="Vom Controlling freigegeben?"><bpmn:incoming>Flow_B_pruef_B_gw</bpmn:incoming><bpmn:outgoing>Flow_B_gw_A_gw2</bpmn:outgoing><bpmn:outgoing>Flow_B_gw_A_ab</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="A_gw2" name="Ab 1.500 € Bestellvolumen?"><bpmn:incoming>Flow_A_gw1_A_gw2</bpmn:incoming><bpmn:incoming>Flow_B_gw_A_gw2</bpmn:incoming><bpmn:outgoing>Flow_A_gw2_A_ang1</bpmn:outgoing><bpmn:outgoing>Flow_A_gw2_A_frei</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_ang1" name="Angebote neu holen"><bpmn:incoming>Flow_A_gw2_A_ang1</bpmn:incoming><bpmn:outgoing>Flow_A_ang1_A_wl</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_wl" name="Werkleitung um Freigabe bitten"><bpmn:incoming>Flow_A_ang1_A_wl</bpmn:incoming><bpmn:outgoing>Flow_A_wl_C_pruef</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="C_pruef" name="Bestellvolumen prüfen"><bpmn:incoming>Flow_A_wl_C_pruef</bpmn:incoming><bpmn:outgoing>Flow_C_pruef_C_gw</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="C_gw" name="Von der Werkleitung freigegeben?"><bpmn:incoming>Flow_C_pruef_C_gw</bpmn:incoming><bpmn:outgoing>Flow_C_gw_A_gw3</bpmn:outgoing><bpmn:outgoing>Flow_C_gw_A_ab</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="A_gw3" name="Ab 10.000 € und ohne Lead-Buyer-Abschluss?"><bpmn:incoming>Flow_C_gw_A_gw3</bpmn:incoming><bpmn:outgoing>Flow_A_gw3_A_ang2</bpmn:outgoing><bpmn:outgoing>Flow_A_gw3_A_frei</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_ang2" name="Angebote neu holen"><bpmn:incoming>Flow_A_gw3_A_ang2</bpmn:incoming><bpmn:outgoing>Flow_A_ang2_A_se</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_se" name="Strategischen Einkauf um Freigabe bitten"><bpmn:incoming>Flow_A_ang2_A_se</bpmn:incoming><bpmn:outgoing>Flow_A_se_D_pruef</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="D_pruef" name="Konzernrahmen prüfen"><bpmn:incoming>Flow_A_se_D_pruef</bpmn:incoming><bpmn:outgoing>Flow_D_pruef_D_gw</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="D_gw" name="Vom strategischen Einkauf freigegeben?"><bpmn:incoming>Flow_D_pruef_D_gw</bpmn:incoming><bpmn:outgoing>Flow_D_gw_A_frei</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_A_ab</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_frei" name="Freigeben und Antragsteller benachrichtigen"><bpmn:incoming>Flow_A_gw2_A_frei</bpmn:incoming><bpmn:incoming>Flow_A_gw3_A_frei</bpmn:incoming><bpmn:incoming>Flow_D_gw_A_frei</bpmn:incoming><bpmn:outgoing>Flow_A_frei_A_endOk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_endOk" name="Freigegeben"><bpmn:incoming>Flow_A_frei_A_endOk</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_ab" name="Ablehnen und Antragsteller benachrichtigen"><bpmn:incoming>Flow_B_gw_A_ab</bpmn:incoming><bpmn:incoming>Flow_C_gw_A_ab</bpmn:incoming><bpmn:incoming>Flow_D_gw_A_ab</bpmn:incoming><bpmn:outgoing>Flow_A_ab_A_endAb</bpmn:outgoing></bpmn:serviceTask>
