      <bpmndi:BPMNEdge id="Flow_A_einzel_A_besch_di" bpmnElement="Flow_A_einzel_A_besch"><di:waypoint x="671" y="130" /><di:waypoint x="709" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_sammel_A_besch_di" bpmnElement="Flow_A_sammel_A_besch"><di:waypoint x="671" y="250" /><di:waypoint x="690" y="250" /><di:waypoint x="690" y="130" /><di:waypoint x="709" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_besch_B_vol_di" bpmnElement="Flow_A_besch_B_vol"><di:waypoint x="841" y="130" /><di:waypoint x="860" y="130" /><di:waypoint x="860" y="390" /><di:waypoint x="879" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_vol_A_gw2_di" bpmnElement="Flow_B_vol_A_gw2"><di:waypoint x="1011" y="390" /><di:waypoint x="1051" y="390" /><di:waypoint x="1051" y="130" /><di:waypoint x="1090" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw2_A_ang_di" bpmnElement="Flow_A_gw2_A_ang"><di:waypoint x="1115" y="155" /><di:waypoint x="1115" y="250" /><di:waypoint x="1219" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="1123" y="233" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw2_A_send_di" bpmnElement="Flow_A_gw2_A_send"><di:waypoint x="1140" y="130" /><di:waypoint x="1389" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="1146" y="113" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
