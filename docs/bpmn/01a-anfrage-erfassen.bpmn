      <bpmndi:BPMNShape id="A_einzel_di" bpmnElement="A_einzel" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="539" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_sammel_di" bpmnElement="A_sammel" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="539" y="208" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_besch_di" bpmnElement="A_besch" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="709" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_vol_di" bpmnElement="B_vol" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="879" y="348" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_gw2_di" bpmnElement="A_gw2" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="1090" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="86" width="96" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_ang_di" bpmnElement="A_ang" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="1219" y="208" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_send_di" bpmnElement="A_send" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="1389" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_save_di" bpmnElement="B_save" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="1559" y="348" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_end_di" bpmnElement="B_end" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="1777" y="372" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1735" y="413" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A_start_A_gw1_di" bpmnElement="Flow_A_start_A_gw1"><di:waypoint x="283" y="130" /><di:waypoint x="410" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw1_A_einzel_di" bpmnElement="Flow_A_gw1_A_einzel"><di:waypoint x="460" y="130" /><di:waypoint x="539" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="466" y="113" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
