<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_erfassen" targetNamespace="https://bedarfsanfrage.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_erfassen">
    <bpmn:participant id="P_Erf" name="DIHAG SHB · Anfrage erfassen" processRef="Process_Bedarfsanfrage_Erfassen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bedarfsanfrage_Erfassen" name="Anfrage erfassen und einreichen" isExecutable="false">
    <bpmn:documentation>Der Antragsteller erfasst den Bedarf im Assistenten der App, als Einzelanfrage oder als Sammelanfrage mit mehreren Positionen. Favoriten und Wiedervorlagen füllen den Assistenten vor. Aus Menge und Einzelpreis rechnet die App das Bestellvolumen und zeigt den Genehmigungsweg nach Regelwerk. Ab 500 € verlangt das Regelwerk Angebote, beim Lead-Buyer-Abschluss entfällt die Pflicht. Mit dem Einreichen speichert die App die Anfrage mit dem Status Eingereicht.
Eingebunden in: Bedarfsanfrage.
Anwender-Ansicht: https://bedarfsanfrage.dihag-extern.com/?ansicht=prozess&amp;modell=erfassen
Im Einklang mit den Richtlinien: Konzernfachregelung Prozessmanagement; ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=120,119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Erf">
      <bpmn:lane id="LA" name="Antragsteller (Fachbereich)"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>A_einzel</bpmn:flowNodeRef><bpmn:flowNodeRef>A_sammel</bpmn:flowNodeRef><bpmn:flowNodeRef>A_besch</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ang</bpmn:flowNodeRef><bpmn:flowNodeRef>A_send</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Bedarfsanfrage-App"><bpmn:flowNodeRef>B_vol</bpmn:flowNodeRef><bpmn:flowNodeRef>B_save</bpmn:flowNodeRef><bpmn:flowNodeRef>B_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Bedarf soll angefragt werden"><bpmn:outgoing>Flow_A_start_A_gw1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_gw1" name="Mehrere Positionen?"><bpmn:incoming>Flow_A_start_A_gw1</bpmn:incoming><bpmn:outgoing>Flow_A_gw1_A_einzel</bpmn:outgoing><bpmn:outgoing>Flow_A_gw1_A_sammel</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="A_einzel" name="Einzelanfrage erfassen"><bpmn:incoming>Flow_A_gw1_A_einzel</bpmn:incoming><bpmn:outgoing>Flow_A_einzel_A_besch</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="A_sammel" name="Sammelanfrage mit Positionen erfassen"><bpmn:incoming>Flow_A_gw1_A_sammel</bpmn:incoming><bpmn:outgoing>Flow_A_sammel_A_besch</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="A_besch" name="Beschaffung, Lieferant und Abteilung angeben"><bpmn:incoming>Flow_A_einzel_A_besch</bpmn:incoming><bpmn:incoming>Flow_A_sammel_A_besch</bpmn:incoming><bpmn:outgoing>Flow_A_besch_B_vol</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="B_vol" name="Bestellvolumen und Genehmigungsweg anzeigen"><bpmn:incoming>Flow_A_besch_B_vol</bpmn:incoming><bpmn:outgoing>Flow_B_vol_A_gw2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_gw2" name="Angebote nötig?"><bpmn:incoming>Flow_B_vol_A_gw2</bpmn:incoming><bpmn:outgoing>Flow_A_gw2_A_ang</bpmn:outgoing><bpmn:outgoing>Flow_A_gw2_A_send</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="A_ang" name="Vorhandene Angebote anhängen"><bpmn:incoming>Flow_A_gw2_A_ang</bpmn:incoming><bpmn:outgoing>Flow_A_ang_A_send</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="A_send" name="Zusammenfassung prüfen und einreichen"><bpmn:incoming>Flow_A_gw2_A_send</bpmn:incoming><bpmn:incoming>Flow_A_ang_A_send</bpmn:incoming><bpmn:outgoing>Flow_A_send_B_save</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="B_save" name="Anfrage mit Status Eingereicht speichern"><bpmn:incoming>Flow_A_send_B_save</bpmn:incoming><bpmn:outgoing>Flow_B_save_B_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="B_end" name="Anfrage eingereicht"><bpmn:incoming>Flow_B_save_B_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_gw1" sourceRef="A_start" targetRef="A_gw1" />
      <bpmn:sequenceFlow id="Flow_A_gw1_A_einzel" sourceRef="A_gw1" targetRef="A_einzel" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_gw1_A_sammel" sourceRef="A_gw1" targetRef="A_sammel" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_einzel_A_besch" sourceRef="A_einzel" targetRef="A_besch" />
      <bpmn:sequenceFlow id="Flow_A_sammel_A_besch" sourceRef="A_sammel" targetRef="A_besch" />
      <bpmn:sequenceFlow id="Flow_A_besch_B_vol" sourceRef="A_besch" targetRef="B_vol" />
      <bpmn:sequenceFlow id="Flow_B_vol_A_gw2" sourceRef="B_vol" targetRef="A_gw2" />
      <bpmn:sequenceFlow id="Flow_A_gw2_A_ang" sourceRef="A_gw2" targetRef="A_ang" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gw2_A_send" sourceRef="A_gw2" targetRef="A_send" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_ang_A_send" sourceRef="A_ang" targetRef="A_send" />
      <bpmn:sequenceFlow id="Flow_A_send_B_save" sourceRef="A_send" targetRef="B_save" />
      <bpmn:sequenceFlow id="Flow_B_save_B_end" sourceRef="B_save" targetRef="B_end" />
      <bpmn:textAnnotation id="An_fav"><bpmn:text>Favoriten und Wiedervorlagen füllen den Assistenten vor.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_fav" associationDirection="None" sourceRef="A_start" targetRef="An_fav" />
      <bpmn:textAnnotation id="An_ang"><bpmn:text>Der Genehmigungsweg nennt die Angebote nach Regelwerk: ab 500 € 2 bis 5, beim Lead-Buyer-Abschluss keine.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_ang" associationDirection="None" sourceRef="B_vol" targetRef="An_ang" />
      <bpmn:textAnnotation id="An_save"><bpmn:text>Ein Datum zur automatischen Bedarfsanfrage merkt die Anfrage für den Auto-Entwurf vor.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_save" associationDirection="None" sourceRef="B_save" targetRef="An_save" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_erfassen">
    <bpmndi:BPMNPlane id="Plane_erfassen" bpmnElement="Collab_erfassen">
      <bpmndi:BPMNShape id="P_Erf_di" bpmnElement="P_Erf" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#1A2644"><dc:Bounds x="100" y="60" width="1810" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LA_di" bpmnElement="LA" isHorizontal="true" bioc:stroke="#C2410C" bioc:fill="#FFF8F1" color:background-color="#FFF8F1" color:border-color="#C2410C"><dc:Bounds x="130" y="60" width="1780" height="260" /></bpmndi:BPMNShape>
