<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_autoentwurf" targetNamespace="https://bedarfsanfrage.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:category id="Cat_G_je"><bpmn:categoryValue id="CV_G_je" value="je fällige Anfrage" /></bpmn:category>
  <bpmn:collaboration id="Collab_autoentwurf">
    <bpmn:participant id="P_Auto" name="DIHAG SHB · Auto-Entwurf" processRef="Process_Bedarfsanfrage_AutoEntwurf" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bedarfsanfrage_AutoEntwurf" name="Auto-Entwurf (Wiedervorlage)" isExecutable="false">
    <bpmn:documentation>Für wiederkehrende Bedarfe. Hat eine Anfrage ein Datum zur automatischen Bedarfsanfrage, legt ein täglicher Lauf in GitHub Actions an diesem Tag eine Kopie als Entwurf an (Status Automatisch erstellter Entwurf) und leert das Datum an der Vorlage, damit kein zweiter Entwurf entsteht. Öffnet der Einkauf den Entwurf, wandert er wie eine eingereichte Anfrage in die Prüfung.
Anwender-Ansicht: https://bedarfsanfrage.dihag-extern.com/?ansicht=prozess&amp;modell=autoentwurf
Im Einklang mit den Richtlinien: Konzernfachregelung Prozessmanagement; ISMS-Richtlinie Sichere Softwareentwicklung
[[rms:policies=120,111]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Auto">
      <bpmn:lane id="LA" name="Automatik (GitHub Actions)"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_suche</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>A_nichts</bpmn:flowNodeRef><bpmn:flowNodeRef>A_kopie</bpmn:flowNodeRef><bpmn:flowNodeRef>A_leeren</bpmn:flowNodeRef><bpmn:flowNodeRef>A_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Täglich um 6 Uhr"><bpmn:outgoing>Flow_A_start_A_suche</bpmn:outgoing><bpmn:timerEventDefinition id="A_start_def" /></bpmn:startEvent>
      <bpmn:serviceTask id="A_suche" name="Fällige Wiedervorlagen suchen"><bpmn:incoming>Flow_A_start_A_suche</bpmn:incoming><bpmn:outgoing>Flow_A_suche_A_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_gw" name="Fällige Anfrage gefunden?"><bpmn:incoming>Flow_A_suche_A_gw</bpmn:incoming><bpmn:outgoing>Flow_A_gw_A_kopie</bpmn:outgoing><bpmn:outgoing>Flow_A_gw_A_nichts</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_nichts" name="Nichts fällig"><bpmn:incoming>Flow_A_gw_A_nichts</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_kopie" name="Kopie als Entwurf anlegen"><bpmn:incoming>Flow_A_gw_A_kopie</bpmn:incoming><bpmn:outgoing>Flow_A_kopie_A_leeren</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_leeren" name="Datum an der Vorlage leeren"><bpmn:incoming>Flow_A_kopie_A_leeren</bpmn:incoming><bpmn:outgoing>Flow_A_leeren_A_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_end" name="Entwurf liegt bereit"><bpmn:incoming>Flow_A_leeren_A_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_suche" sourceRef="A_start" targetRef="A_suche" />
      <bpmn:sequenceFlow id="Flow_A_suche_A_gw" sourceRef="A_suche" targetRef="A_gw" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_kopie" sourceRef="A_gw" targetRef="A_kopie" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_nichts" sourceRef="A_gw" targetRef="A_nichts" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_kopie_A_leeren" sourceRef="A_kopie" targetRef="A_leeren" />
      <bpmn:sequenceFlow id="Flow_A_leeren_A_end" sourceRef="A_leeren" targetRef="A_end" />
      <bpmn:textAnnotation id="An_takt"><bpmn:text>5 Uhr UTC, im Sommer also 7 Uhr. GitHub startet oft einige Minuten später.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_takt" associationDirection="None" sourceRef="A_start" targetRef="An_takt" />
      <bpmn:textAnnotation id="An_weiter"><bpmn:text>Status Automatisch erstellter Entwurf. Öffnet der Einkauf ihn, wandert er in die Prüfung (Hauptprozess).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_weiter" associationDirection="None" sourceRef="A_end" targetRef="An_weiter" />
      <bpmn:group id="G_je" categoryValueRef="CV_G_je" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_autoentwurf">
    <bpmndi:BPMNPlane id="Plane_autoentwurf" bpmnElement="Collab_autoentwurf">
      <bpmndi:BPMNShape id="P_Auto_di" bpmnElement="P_Auto" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#1A2644"><dc:Bounds x="100" y="60" width="1300" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LA_di" bpmnElement="LA" isHorizontal="true" bioc:stroke="#17509E" bioc:fill="#F3F8FE" color:background-color="#F3F8FE" color:border-color="#17509E"><dc:Bounds x="130" y="60" width="1270" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_start_di" bpmnElement="A_start" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="247" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="205" y="92" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_suche_di" bpmnElement="A_suche" bioc:stroke="#17509E" bioc:fill="#D8E8F8" color:background-color="#D8E8F8" color:border-color="#17509E"><dc:Bounds x="369" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_gw_di" bpmnElement="A_gw" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="580" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="505" y="73" width="96" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_nichts_di" bpmnElement="A_nichts" bioc:stroke="#8A8F98" bioc:fill="#F1F1F3" color:background-color="#F1F1F3" color:border-color="#8A8F98"><dc:Bounds x="757" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="715" y="273" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_kopie_di" bpmnElement="A_kopie" bioc:stroke="#17509E" bioc:fill="#D8E8F8" color:background-color="#D8E8F8" color:border-color="#17509E"><dc:Bounds x="709" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_leeren_di" bpmnElement="A_leeren" bioc:stroke="#17509E" bioc:fill="#D8E8F8" color:background-color="#D8E8F8" color:border-color="#17509E"><dc:Bounds x="879" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_end_di" bpmnElement="A_end" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="1097" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1055" y="92" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A_start_A_suche_di" bpmnElement="Flow_A_start_A_suche"><di:waypoint x="283" y="130" /><di:waypoint x="369" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_suche_A_gw_di" bpmnElement="Flow_A_suche_A_gw"><di:waypoint x="501" y="130" /><di:waypoint x="580" y="130" /></bpmndi:BPMNEdge>
