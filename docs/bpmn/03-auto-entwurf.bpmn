      <bpmndi:BPMNEdge id="Flow_A_kopie_A_leeren_di" bpmnElement="Flow_A_kopie_A_leeren"><di:waypoint x="841" y="130" /><di:waypoint x="879" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_leeren_A_end_di" bpmnElement="Flow_A_leeren_A_end"><di:waypoint x="1011" y="130" /><di:waypoint x="1097" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="An_takt_di" bpmnElement="An_takt" bioc:stroke="#6B7280" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#6B7280"><dc:Bounds x="190" y="219" width="150" height="62" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_An_takt_di" bpmnElement="Assoc_An_takt"><di:waypoint x="265" y="148" /><di:waypoint x="265" y="219" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="An_weiter_di" bpmnElement="An_weiter" bioc:stroke="#6B7280" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#6B7280"><dc:Bounds x="1040" y="219" width="220" height="62" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_An_weiter_di" bpmnElement="Assoc_An_weiter"><di:waypoint x="1115" y="148" /><di:waypoint x="1115" y="219" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="G_je_di" bpmnElement="G_je" bioc:stroke="#17509E" color:border-color="#17509E"><dc:Bounds x="691" y="64" width="338" height="124" /><bpmndi:BPMNLabel><dc:Bounds x="701" y="70" width="260" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
