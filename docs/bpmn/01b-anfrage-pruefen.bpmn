      <bpmndi:BPMNEdge id="Flow_A_gw2_B_ok_di" bpmnElement="Flow_A_gw2_B_ok"><di:waypoint x="1115" y="155" /><di:waypoint x="1115" y="390" /><di:waypoint x="1219" y="390" /><bpmndi:BPMNLabel><dc:Bounds x="1123" y="373" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw2_A_grund_di" bpmnElement="Flow_A_gw2_A_grund"><di:waypoint x="1140" y="130" /><di:waypoint x="1219" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="1146" y="113" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_ok_B_endOk_di" bpmnElement="Flow_B_ok_B_endOk"><di:waypoint x="1351" y="390" /><di:waypoint x="1437" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_grund_B_ab_di" bpmnElement="Flow_A_grund_B_ab"><di:waypoint x="1351" y="130" /><di:waypoint x="1370" y="130" /><di:waypoint x="1370" y="510" /><di:waypoint x="1389" y="510" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_ab_B_endAb_di" bpmnElement="Flow_B_ab_B_endAb"><di:waypoint x="1521" y="510" /><di:waypoint x="1607" y="510" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="An_zust_di" bpmnElement="An_zust" bioc:stroke="#6B7280" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#6B7280"><dc:Bounds x="360" y="219" width="150" height="62" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_An_zust_di" bpmnElement="Assoc_An_zust"><di:waypoint x="435" y="172" /><di:waypoint x="435" y="219" /></bpmndi:BPMNEdge>
