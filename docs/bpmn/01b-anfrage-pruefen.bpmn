<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_pruefen" targetNamespace="https://bedarfsanfrage.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_pruefen">
    <bpmn:participant id="P_Pruef" name="DIHAG SHB · Anfrage prüfen und entscheiden" processRef="Process_Bedarfsanfrage_Einkauf" />
    <bpmn:participant id="P_Lief" name="Lieferant" />
    <bpmn:messageFlow id="Msg_A_ang_P_Lief" name="Angebotsanfrage" sourceRef="A_ang" targetRef="P_Lief" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bedarfsanfrage_Einkauf" name="Anfrage prüfen und entscheiden" isExecutable="false">
    <bpmn:documentation>Der Einkauf prüft die Anfrage in der App. Zuständig ist, wem die Warengruppe in der Zugriffssteuerung zugeordnet ist, ohne Zuordnung sind es alle Einkäufer. Fehlen Angebote nach Regelwerk, holt der Einkauf sie beim Lieferanten ein und hängt sie an. Danach genehmigt er oder lehnt mit Grund ab. Die App speichert Status und Entscheider. Eine Mail geht dabei nicht raus, der Antragsteller sieht das Ergebnis in Meine Anfragen.
Eingebunden in: Bedarfsanfrage.
Anwender-Ansicht: https://bedarfsanfrage.dihag-extern.com/?ansicht=prozess&amp;modell=pruefen
Im Einklang mit den Richtlinien: Konzernfachregelung Prozessmanagement; ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=120,119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Pruef">
      <bpmn:lane id="LA" name="Einkauf"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_res</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ang</bpmn:flowNodeRef><bpmn:flowNodeRef>A_bew</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>A_grund</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Bedarfsanfrage-App"><bpmn:flowNodeRef>B_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>B_endOk</bpmn:flowNodeRef><bpmn:flowNodeRef>B_ab</bpmn:flowNodeRef><bpmn:flowNodeRef>B_endAb</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Anfrage steht auf In Prüfung (Einkauf)"><bpmn:outgoing>Flow_A_start_A_res</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="A_res" name="Anfrage reservieren und Angaben prüfen"><bpmn:incoming>Flow_A_start_A_res</bpmn:incoming><bpmn:outgoing>Flow_A_res_A_gw1</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="A_gw1" name="Angebote vollständig?"><bpmn:incoming>Flow_A_res_A_gw1</bpmn:incoming><bpmn:outgoing>Flow_A_gw1_A_bew</bpmn:outgoing><bpmn:outgoing>Flow_A_gw1_A_ang</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="A_ang" name="Angebote beim Lieferanten einholen und anhängen"><bpmn:incoming>Flow_A_gw1_A_ang</bpmn:incoming><bpmn:outgoing>Flow_A_ang_A_bew</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="A_bew" name="Bedarf, Preis und Lieferant bewerten"><bpmn:incoming>Flow_A_gw1_A_bew</bpmn:incoming><bpmn:incoming>Flow_A_ang_A_bew</bpmn:incoming><bpmn:outgoing>Flow_A_bew_A_gw2</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="A_gw2" name="Bedarf genehmigen?"><bpmn:incoming>Flow_A_bew_A_gw2</bpmn:incoming><bpmn:outgoing>Flow_A_gw2_B_ok</bpmn:outgoing><bpmn:outgoing>Flow_A_gw2_A_grund</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="A_grund" name="Ablehnungsgrund eintragen"><bpmn:incoming>Flow_A_gw2_A_grund</bpmn:incoming><bpmn:outgoing>Flow_A_grund_B_ab</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="B_ok" name="Status Genehmigt (Einkauf) speichern"><bpmn:incoming>Flow_A_gw2_B_ok</bpmn:incoming><bpmn:outgoing>Flow_B_ok_B_endOk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="B_endOk" name="Vom Einkauf genehmigt"><bpmn:incoming>Flow_B_ok_B_endOk</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="B_ab" name="Status Abgelehnt mit Grund speichern"><bpmn:incoming>Flow_A_grund_B_ab</bpmn:incoming><bpmn:outgoing>Flow_B_ab_B_endAb</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="B_endAb" name="Vom Einkauf abgelehnt"><bpmn:incoming>Flow_B_ab_B_endAb</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_res" sourceRef="A_start" targetRef="A_res" />
      <bpmn:sequenceFlow id="Flow_A_res_A_gw1" sourceRef="A_res" targetRef="A_gw1" />
      <bpmn:sequenceFlow id="Flow_A_gw1_A_bew" sourceRef="A_gw1" targetRef="A_bew" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gw1_A_ang" sourceRef="A_gw1" targetRef="A_ang" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_ang_A_bew" sourceRef="A_ang" targetRef="A_bew" />
      <bpmn:sequenceFlow id="Flow_A_bew_A_gw2" sourceRef="A_bew" targetRef="A_gw2" />
      <bpmn:sequenceFlow id="Flow_A_gw2_B_ok" sourceRef="A_gw2" targetRef="B_ok" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gw2_A_grund" sourceRef="A_gw2" targetRef="A_grund" name="nein" />
      <bpmn:sequenceFlow id="Flow_B_ok_B_endOk" sourceRef="B_ok" targetRef="B_endOk" />
      <bpmn:sequenceFlow id="Flow_A_grund_B_ab" sourceRef="A_grund" targetRef="B_ab" />
      <bpmn:sequenceFlow id="Flow_B_ab_B_endAb" sourceRef="B_ab" targetRef="B_endAb" />
      <bpmn:textAnnotation id="An_zust"><bpmn:text>Zuständig ist, wem die Warengruppe zugeordnet ist. Reservieren hält die Anfrage 8 Std.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_zust" associationDirection="None" sourceRef="A_res" targetRef="An_zust" />
      <bpmn:textAnnotation id="An_mail"><bpmn:text>Keine Mail. Der Antragsteller sieht Status und Grund in Meine Anfragen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_mail" associationDirection="None" sourceRef="A_grund" targetRef="An_mail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_pruefen">
    <bpmndi:BPMNPlane id="Plane_pruefen" bpmnElement="Collab_pruefen">
      <bpmndi:BPMNShape id="P_Pruef_di" bpmnElement="P_Pruef" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#1A2644"><dc:Bounds x="100" y="60" width="1640" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LA_di" bpmnElement="LA" isHorizontal="true" bioc:stroke="#C2410C" bioc:fill="#FFF8F1" color:background-color="#FFF8F1" color:border-color="#C2410C"><dc:Bounds x="130" y="60" width="1610" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LB_di" bpmnElement="LB" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#F3F6FB" color:background-color="#F3F6FB" color:border-color="#1A2644"><dc:Bounds x="130" y="320" width="1610" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Lief_di" bpmnElement="P_Lief" isHorizontal="true" bioc:stroke="#5B6472" bioc:fill="#F6F7F9" color:background-color="#F6F7F9" color:border-color="#5B6472"><dc:Bounds x="100" y="650" width="1640" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_start_di" bpmnElement="A_start" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="247" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="205" y="153" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_res_di" bpmnElement="A_res" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="369" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_gw1_di" bpmnElement="A_gw1" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="580" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="505" y="73" width="96" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_ang_di" bpmnElement="A_ang" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="709" y="208" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_bew_di" bpmnElement="A_bew" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="879" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_gw2_di" bpmnElement="A_gw2" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="1090" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="73" width="96" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_grund_di" bpmnElement="A_grund" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="1219" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_ok_di" bpmnElement="B_ok" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="1219" y="348" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_endOk_di" bpmnElement="B_endOk" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="1437" y="372" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1395" y="413" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_ab_di" bpmnElement="B_ab" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="1389" y="468" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_endAb_di" bpmnElement="B_endAb" bioc:stroke="#B42318" bioc:fill="#FDE2E1" color:background-color="#FDE2E1" color:border-color="#B42318"><dc:Bounds x="1607" y="492" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1565" y="533" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A_start_A_res_di" bpmnElement="Flow_A_start_A_res"><di:waypoint x="283" y="130" /><di:waypoint x="369" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_res_A_gw1_di" bpmnElement="Flow_A_res_A_gw1"><di:waypoint x="501" y="130" /><di:waypoint x="580" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw1_A_bew_di" bpmnElement="Flow_A_gw1_A_bew"><di:waypoint x="630" y="130" /><di:waypoint x="879" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="636" y="113" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_gw1_A_ang_di" bpmnElement="Flow_A_gw1_A_ang"><di:waypoint x="605" y="155" /><di:waypoint x="605" y="250" /><di:waypoint x="709" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="613" y="233" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
