<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_haupt" targetNamespace="https://bedarfsanfrage.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_haupt">
    <bpmn:participant id="P_Banf" name="DIHAG SHB · Bedarfsanfrage" processRef="Process_Bedarfsanfrage" />
    <bpmn:participant id="P_Lief" name="Lieferant" />
    <bpmn:messageFlow id="Msg_C_best_P_Lief" name="Bestellung" sourceRef="C_best" targetRef="P_Lief" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bedarfsanfrage" name="Bedarfsanfrage" isExecutable="false">
    <bpmn:documentation>Ablauf einer Bedarfsanfrage bei SHB von der Erfassung bis zur Bestellung. Der Antragsteller erfasst die Anfrage in der App, gespeichert wird sie in der SharePoint-Liste Bedarfsanfrage auf gruppe_shb. Solange der Einkauf nicht entschieden hat, kann er sie zurückziehen. Öffnet der zuständige Einkauf die Anfrage, setzt die App den Status auf In Prüfung (Einkauf). Der Einkauf genehmigt oder lehnt in der App ab. Nach der Genehmigung läuft der Freigabe-Flow in Power Automate. Ist die Anfrage freigegeben, bestellt der Einkauf im ERP und trägt Bestellnummer, Liefertermin und Preis ein. Dann steht sie auf Bestellt.
Anwender-Ansicht: https://bedarfsanfrage.dihag-extern.com/?ansicht=prozess&amp;modell=haupt
Nebenprozesse: Bedarfsanfrage-AutoEntwurf
[[rms:neben=01NH6NP5DFYDNIEQOLAJHZNZT3627RDOSI]]
Im Einklang mit den Richtlinien: Konzernfachregelung Prozessmanagement; ISMS-Richtlinie Aufbewahrungsfristen und -pflichten; ISMS-Richtlinie Sichere Softwareentwicklung
[[rms:policies=120,119,111]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Banf">
      <bpmn:lane id="LA" name="Antragsteller (Fachbereich)"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_erf</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>A_zur</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endZur</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Bedarfsanfrage-App"><bpmn:flowNodeRef>B_adv</bpmn:flowNodeRef><bpmn:flowNodeRef>B_best</bpmn:flowNodeRef><bpmn:flowNodeRef>B_end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LC" name="Einkauf"><bpmn:flowNodeRef>C_open</bpmn:flowNodeRef><bpmn:flowNodeRef>C_pruef</bpmn:flowNodeRef><bpmn:flowNodeRef>C_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>C_endAb</bpmn:flowNodeRef><bpmn:flowNodeRef>C_best</bpmn:flowNodeRef><bpmn:flowNodeRef>C_daten</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LD" name="Power Automate"><bpmn:flowNodeRef>D_frei</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>D_endAb</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Bedarf entsteht"><bpmn:outgoing>Flow_A_start_A_erf</bpmn:outgoing></bpmn:startEvent>
      <bpmn:callActivity id="A_erf" name="Anfrage erfassen und einreichen" calledElement="Process_Bedarfsanfrage_Erfassen"><bpmn:documentation>Unterprozess: Bedarfsanfrage-Erfassen
[[rms:modell=01NH6NP5HUHMSE6LKN6FBZHNXAX5S2VXPO]]</bpmn:documentation><bpmn:incoming>Flow_A_start_A_erf</bpmn:incoming><bpmn:outgoing>Flow_A_erf_A_gw</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="A_gw" name="Anfrage zurückziehen?"><bpmn:incoming>Flow_A_erf_A_gw</bpmn:incoming><bpmn:outgoing>Flow_A_gw_A_zur</bpmn:outgoing><bpmn:outgoing>Flow_A_gw_C_open</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="A_zur" name="Anfrage in „Meine Anfragen&quot; zurückziehen"><bpmn:incoming>Flow_A_gw_A_zur</bpmn:incoming><bpmn:outgoing>Flow_A_zur_A_endZur</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="A_endZur" name="Anfrage zurückgezogen"><bpmn:incoming>Flow_A_zur_A_endZur</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="C_open" name="Anfrage im Dashboard oder unter Gemeinsame Anfragen öffnen"><bpmn:incoming>Flow_A_gw_C_open</bpmn:incoming><bpmn:outgoing>Flow_C_open_B_adv</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="B_adv" name="Status auf In Prüfung (Einkauf) setzen"><bpmn:incoming>Flow_C_open_B_adv</bpmn:incoming><bpmn:outgoing>Flow_B_adv_C_pruef</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:callActivity id="C_pruef" name="Anfrage prüfen und entscheiden" calledElement="Process_Bedarfsanfrage_Einkauf"><bpmn:documentation>Unterprozess: Bedarfsanfrage-Einkaufsprüfung
[[rms:modell=01NH6NP5CT3ID7HZMK4JBYSAHRU34JWGMB]]</bpmn:documentation><bpmn:incoming>Flow_B_adv_C_pruef</bpmn:incoming><bpmn:outgoing>Flow_C_pruef_C_gw</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="C_gw" name="Vom Einkauf genehmigt?"><bpmn:incoming>Flow_C_pruef_C_gw</bpmn:incoming><bpmn:outgoing>Flow_C_gw_D_frei</bpmn:outgoing><bpmn:outgoing>Flow_C_gw_C_endAb</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="C_endAb" name="Vom Einkauf abgelehnt"><bpmn:incoming>Flow_C_gw_C_endAb</bpmn:incoming></bpmn:endEvent>
      <bpmn:callActivity id="D_frei" name="Freigabelauf durchlaufen" calledElement="Process_Bedarfsanfrage_Freigabelauf"><bpmn:documentation>Unterprozess: Bedarfsanfrage-Freigabelauf
[[rms:modell=01NH6NP5AOD65CF4LUVRCLFWHE6BBQWOI4]]</bpmn:documentation><bpmn:incoming>Flow_C_gw_D_frei</bpmn:incoming><bpmn:outgoing>Flow_D_frei_D_gw</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="D_gw" name="Freigegeben?"><bpmn:incoming>Flow_D_frei_D_gw</bpmn:incoming><bpmn:outgoing>Flow_D_gw_C_best</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_endAb</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="D_endAb" name="In der Freigabe abgelehnt"><bpmn:incoming>Flow_D_gw_D_endAb</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="C_best" name="Bestellung im ERP auslösen"><bpmn:incoming>Flow_D_gw_C_best</bpmn:incoming><bpmn:outgoing>Flow_C_best_C_daten</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="C_daten" name="Bestellnummer, Liefertermin und Preis eintragen"><bpmn:incoming>Flow_C_best_C_daten</bpmn:incoming><bpmn:outgoing>Flow_C_daten_B_best</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="B_best" name="Bestellnummer prüfen und Status Bestellt setzen"><bpmn:incoming>Flow_C_daten_B_best</bpmn:incoming><bpmn:outgoing>Flow_B_best_B_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="B_end" name="Bedarf bestellt"><bpmn:incoming>Flow_B_best_B_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_erf" sourceRef="A_start" targetRef="A_erf" />
      <bpmn:sequenceFlow id="Flow_A_erf_A_gw" sourceRef="A_erf" targetRef="A_gw" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_zur" sourceRef="A_gw" targetRef="A_zur" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gw_C_open" sourceRef="A_gw" targetRef="C_open" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_zur_A_endZur" sourceRef="A_zur" targetRef="A_endZur" />
      <bpmn:sequenceFlow id="Flow_C_open_B_adv" sourceRef="C_open" targetRef="B_adv" />
      <bpmn:sequenceFlow id="Flow_B_adv_C_pruef" sourceRef="B_adv" targetRef="C_pruef" />
      <bpmn:sequenceFlow id="Flow_C_pruef_C_gw" sourceRef="C_pruef" targetRef="C_gw" />
      <bpmn:sequenceFlow id="Flow_C_gw_D_frei" sourceRef="C_gw" targetRef="D_frei" name="ja" />
      <bpmn:sequenceFlow id="Flow_C_gw_C_endAb" sourceRef="C_gw" targetRef="C_endAb" name="nein" />
      <bpmn:sequenceFlow id="Flow_D_frei_D_gw" sourceRef="D_frei" targetRef="D_gw" />
      <bpmn:sequenceFlow id="Flow_D_gw_C_best" sourceRef="D_gw" targetRef="C_best" name="ja" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_endAb" sourceRef="D_gw" targetRef="D_endAb" name="nein" />
      <bpmn:sequenceFlow id="Flow_C_best_C_daten" sourceRef="C_best" targetRef="C_daten" />
      <bpmn:sequenceFlow id="Flow_C_daten_B_best" sourceRef="C_daten" targetRef="B_best" />
      <bpmn:sequenceFlow id="Flow_B_best_B_end" sourceRef="B_best" targetRef="B_end" />
      <bpmn:textAnnotation id="An_zur"><bpmn:text>Geht nur, solange der Einkauf nicht entschieden hat (Eingereicht oder In Prüfung Einkauf). Die App setzt den Status Zurückgezogen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_zur" associationDirection="None" sourceRef="A_zur" targetRef="An_zur" />
      <bpmn:textAnnotation id="An_open"><bpmn:text>Keine Mail bei neuen Anfragen. Was über 48 Std offen ist, markiert die App rot.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_open" associationDirection="None" sourceRef="C_open" targetRef="An_open" />
      <bpmn:textAnnotation id="An_adv"><bpmn:text>Nur beim zuständigen Einkauf. Ein Auto-Entwurf wandert genauso in die Prüfung.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_adv" associationDirection="None" sourceRef="B_adv" targetRef="An_adv" />
  </bpmn:process>
